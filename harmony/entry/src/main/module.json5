{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "extensionAbilities": [
      {
        "name": "ScheduleFormAbility",
        "srcEntry": "./ets/form/ScheduleFormAbility.ets",
        "label": "$string:schedule_card",
        "description": "$string:schedule_card_desc",
        "type": "form",
        "exported": true,
        "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:form_config" }]
      }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" },
      { "name": "ohos.permission.GET_NETWORK_INFO" },
      { "name": "ohos.permission.VIBRATE" },
      { "name": "ohos.permission.PUBLISH_AGENT_REMINDER" },
      { "name": "ohos.permission.GET_DONOTDISTURB_STATE" },
      { "name": "ohos.permission.READ_CALENDAR", "reason": "$string:calendar_permission",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } },
      { "name": "ohos.permission.WRITE_CALENDAR", "reason": "$string:calendar_permission",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" } }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:start_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:start_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "metadata": [{ "name": "ohos.ability.shortcuts", "resource": "$profile:shortcuts_config" }],
        "skills": [
          { "entities": ["entity.system.home"], "actions": ["ohos.want.action.home"] },
          {
            "entities": ["entity.system.browsable"],
            "actions": ["ohos.want.action.viewData"],
            "uris": [{ "scheme": "iwut", "host": "share" }]
          }
        ]
      }
    ]
  }
}
